{
	"lock": false,
	"exports": {},
	"tasks": {
		"test": "deno test",
		"build": "deno run -A scripts/build.ts"
	},
	"imports": {
		"@node-minify/core": "npm:@node-minify/core@^11.0.0",
		"@node-minify/html-minifier": "npm:@node-minify/html-minifier@^11.0.0",
		"@node-minify/lightningcss": "npm:@node-minify/lightningcss@^11.0.0",
		"@node-minify/minify-html": "npm:@node-minify/minify-html@^11.0.0",
		"@std/media-types": "jsr:@std/media-types@^1.1.0",
		"@std/assert": "jsr:@std/assert@^1.0.15",
		"@std/async": "jsr:@std/async@^1.0.15",
		"@std/regexp": "jsr:@std/regexp@^1.0.2",
		"~/": "./"
	},
	"fmt": {
		"semiColons": false,
		"useTabs": true,
		"lineWidth": 120,
		"indentWidth": 4,
		"singleQuote": true,
		"proseWrap": "preserve",
		"exclude": []
	},
	"compilerOptions": {
		"strict": true,
		"useUnknownInCatchVariables": true,
		"lib": [
			"deno.window",
			"deno.unstable",
			"dom",
			"dom.iterable"
		]
	},
	"lint": {
		"exclude": [],
		"rules": {
			"tags": ["recommended"],
			"exclude": ["no-window", "no-window-prefix"],
			"include": ["no-console"]
		}
	},
	"exclude": []
}
